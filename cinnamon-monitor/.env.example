# SQLite for local development.
# For PostgreSQL: set provider = "postgresql" in prisma/schema.prisma and use
# DATABASE_URL="postgresql://user:password@localhost:5432/cinnamon?schema=public"
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Session lifetime in days
SESSION_DAYS=7

# ---------------------------------------------------------------------------
# PostgreSQL (Neon in production)
# ---------------------------------------------------------------------------
# DATABASE_URL — the POOLED connection. Its host contains "-pooler".
# Used by the running app. Prisma needs the pgbouncer flag on a pooled Neon URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# DIRECT_URL — the DIRECT connection. Same host WITHOUT "-pooler".
# Used only by `prisma migrate`, which cannot run through a connection pooler.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
# Changing it signs every user out.
JWT_SECRET="change-me-to-a-long-random-string"

# Session lifetime in days (optional, defaults to 7)
SESSION_DAYS=7

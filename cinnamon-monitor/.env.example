# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# The values below match docker-compose.yml, so for local development you can
# copy this file to .env and change nothing:
#     cp .env.example .env && npm run db:up && npm run setup
DATABASE_URL="postgresql://cinnamon:cinnamon@localhost:5432/cinnamon"
DIRECT_URL="postgresql://cinnamon:cinnamon@localhost:5432/cinnamon"

# For Neon / production, both are set in the Vercel dashboard instead:
#   DATABASE_URL — the POOLED url (host contains "-pooler"), used by the app:
#     postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
#   DIRECT_URL   — the DIRECT url (no "-pooler"), used only by prisma migrate:
#     postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
# See DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Fine as-is for local development. In production generate a real one with:
#   openssl rand -base64 32
# Changing it signs every user out.
JWT_SECRET="local-development-secret-change-in-production"

# Session lifetime in days (optional, defaults to 7)
SESSION_DAYS=7

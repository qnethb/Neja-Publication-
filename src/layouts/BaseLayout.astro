---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsAppBar from '../components/StickyWhatsAppBar.astro';
import { site } from '../data/site.js';

const {
  title,
  description = site.defaultDescription,
  image = site.ogDefault,
  type = 'website',
  lang = 'si',
  showStickyCta = true,
  stickyHref,
  stickyLabel,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.defaultTitle;

// Build absolute URLs for canonical + Open Graph (Facebook needs absolute og:image).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang} class="no-js scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0D0D0D" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph (traffic comes from Facebook — these drive link previews) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: Abhaya Libre (Sinhala) + Noto Sans (English) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@400;500;600;700;800&family=Noto+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Flip the no-js flag as early as possible so .reveal works with JS on -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body class="min-h-screen bg-ink text-parchment antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="pb-24 md:pb-0">
      <slot />
    </main>
    <Footer />
    {showStickyCta && <StickyWhatsAppBar href={stickyHref} label={stickyLabel} />}

    <!-- Only JS on the site: subtle scroll-reveal via IntersectionObserver -->
    <script is:inline>
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site.js';
import { genericContactLink } from '../lib/whatsapp.js';
import { isConfirmed } from '../data/books.js';

const hasEmail = isConfirmed(site.email);
const hasFacebook = isConfirmed(site.facebook);
---

<BaseLayout
  title="Contact"
  description="Order or ask a question — reach Neja Publications on WhatsApp or Facebook."
>
  <section class="mx-auto max-w-3xl px-4 py-14 md:px-6 md:py-20">
    <header class="reveal mb-12 text-center">
      <h1 class="text-4xl font-bold text-parchment md:text-5xl">Contact</h1>
      <p class="mt-3 font-sinhala text-lg text-muted" lang="si">සම්බන්ධ වන්න</p>
    </header>

    <!-- Primary: WhatsApp -->
    <div
      class="reveal rounded-2xl border border-whatsapp/30 bg-gradient-to-br from-ink-soft to-indigo/10 p-8 text-center"
    >
      <h2 class="text-2xl font-bold text-parchment">Order on WhatsApp</h2>
      <p class="mt-2 text-sm text-muted">
        The fastest way to order — islandwide delivery, cash on delivery.
      </p>
      <p class="mt-1 text-base font-semibold text-gold">{site.whatsappDisplay}</p>
      <div class="mt-6 flex justify-center">
        <WhatsAppButton href={genericContactLink()} label="WhatsApp ඔස්සේ විමසන්න" />
      </div>
    </div>

    <!-- Secondary links -->
    <div class="reveal mt-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-white/8 bg-ink-soft p-6 text-center">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gold/80">Facebook</h3>
        {
          hasFacebook ? (
            <a
              href={site.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-block text-parchment/85 transition-colors hover:text-gold"
            >
              Visit our page &rarr;
            </a>
          ) : (
            <p class="mt-3 text-sm text-muted">{site.facebook}</p>
          )
        }
      </div>
      <div class="rounded-2xl border border-white/8 bg-ink-soft p-6 text-center">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gold/80">Email</h3>
        {
          hasEmail ? (
            <a
              href={`mailto:${site.email}`}
              class="mt-3 inline-block text-parchment/85 transition-colors hover:text-gold"
            >
              {site.email}
            </a>
          ) : (
            <p class="mt-3 text-sm text-muted">{site.email}</p>
          )
        }
      </div>
    </div>

    <!-- Optional mailto contact form (no backend; opens the visitor's email app) -->
    <div class="reveal mt-6 rounded-2xl border border-white/8 bg-ink-soft p-6 md:p-8">
      <h2 class="text-xl font-bold text-parchment">Send a message</h2>
      <p class="mt-1 text-sm text-muted">
        This opens your email app with the message pre-filled. No data is stored.
      </p>

      {
        hasEmail ? (
          <form id="contact-form" class="mt-6 space-y-4">
            <div>
              <label for="cf-name" class="block text-sm text-parchment/80">Name</label>
              <input
                id="cf-name"
                name="name"
                type="text"
                required
                class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-4 py-2.5 text-parchment placeholder:text-muted/60 focus:border-gold focus:outline-none"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="cf-message" class="block text-sm text-parchment/80">Message</label>
              <textarea
                id="cf-message"
                name="message"
                rows="4"
                required
                class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-4 py-2.5 text-parchment placeholder:text-muted/60 focus:border-gold focus:outline-none"
                placeholder="How can we help?"
              />
            </div>
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-full bg-gold px-6 py-3 font-semibold text-ink transition-colors hover:bg-gold-soft"
            >
              Open email
            </button>
          </form>

          <script is:inline define:vars={{ email: site.email }}>
            const form = document.getElementById('contact-form');
            form?.addEventListener('submit', (e) => {
              e.preventDefault();
              const data = new FormData(form);
              const name = data.get('name') || '';
              const message = data.get('message') || '';
              const subject = encodeURIComponent(`Enquiry from ${name} — Neja Publications`);
              const body = encodeURIComponent(`${message}\n\n— ${name}`);
              window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
            });
          </script>
        ) : (
          <p class="mt-6 rounded-lg border border-dashed border-gold/30 bg-ink p-4 text-sm text-muted">
            The contact form will be enabled once a contact email is confirmed
            ({site.email}). In the meantime, please order or enquire on WhatsApp.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { genericContactLink } from '../lib/whatsapp.js';

// News / announcements stub. Intentionally empty — no invented dates or releases.
// TODO: when there is real news, add entries here, e.g.
//   const announcements = [{ date: '…', titleSi: '…', body: '…' }];
const announcements = [];
---

<BaseLayout
  title="News"
  description="New releases and announcements from Neja Publications."
>
  <section class="mx-auto max-w-3xl px-4 py-14 md:px-6 md:py-20">
    <header class="reveal mb-12 text-center">
      <h1 class="text-4xl font-bold text-parchment md:text-5xl">News</h1>
      <p class="mt-3 font-sinhala text-lg text-muted" lang="si">පුවත්</p>
    </header>

    {
      announcements.length === 0 ? (
        <div class="reveal rounded-2xl border border-dashed border-gold/30 bg-ink-soft px-6 py-16 text-center">
          <p class="text-lg text-parchment/85">No announcements yet.</p>
          <p class="mt-2 font-sinhala text-base text-muted" lang="si">
            තවම නිවේදන නැත.
          </p>
          <p class="mt-6 text-sm text-muted">
            Follow us for new releases — or message us on WhatsApp to be notified.
          </p>
          <div class="mt-7 flex justify-center">
            <WhatsAppButton
              href={genericContactLink()}
              variant="outline"
              label="WhatsApp ඔස්සේ විමසන්න"
            />
          </div>
        </div>
      ) : (
        <ul class="space-y-6">
          {announcements.map((a) => (
            <li class="reveal rounded-2xl border border-white/8 bg-ink-soft p-6">
              <p class="text-xs uppercase tracking-wider text-indigo-soft">{a.date}</p>
              <h2 class="mt-2 text-xl font-bold text-gold">{a.titleSi}</h2>
              <p class="mt-2 text-parchment/75">{a.body}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

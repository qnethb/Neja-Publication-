---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site.js';
import { genericContactLink } from '../lib/whatsapp.js';

const sections = [
  {
    kicker: 'Why Neja exists',
    title: 'Stories with the scale of cinema',
    bodySi:
      'සිංහල කතාන්දරකරණයේ ගැඹුර හා සුන්දරත්වය නව පරම්පරාවකට ගෙන ඒම සඳහා නේජා ප්‍රකාශන බිහි විය.',
    body:
      'Neja Publications exists to bring the depth and beauty of Sinhala storytelling to a new generation — books written and presented with the atmosphere, scale, and emotion of cinema.',
  },
  {
    kicker: 'Our mission',
    title: 'Premium Sinhala literature, made unmissable',
    body:
      'To publish bold, immersive Sinhala fiction and present it with the craft it deserves — from the cover to the page to the way readers discover it. Every title is a world worth stepping into.',
  },
  {
    kicker: 'Our vision',
    title: 'The future of cinematic Sinhala storytelling',
    body:
      'A future where Sinhala novels are anticipated like films — with trailers, atmosphere, and a community of readers who feel each release as an event.',
  },
  {
    kicker: 'Where we are going',
    title: 'More worlds, more voices',
    body:
      'We are building a growing library of cinematic Sinhala titles, supporting new and established authors, and meeting readers wherever they are — on their phones, one tap from ordering.',
  },
];
---

<BaseLayout
  title="About"
  description="Neja Publications brings the depth of Sinhala literature to a new generation — stories told with the atmosphere and scale of cinema."
>
  <section class="relative isolate overflow-hidden border-b border-white/5">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-burgundy-deep via-ink to-indigo"></div>
    <div class="mx-auto max-w-3xl px-4 py-20 text-center md:px-6 md:py-28">
      <p class="reveal text-xs uppercase tracking-[0.3em] text-gold/80">About Us</p>
      <h1 class="reveal mt-5 font-sinhala text-4xl font-extrabold text-parchment md:text-5xl" lang="si">
        {site.nameSi}
      </h1>
      <p class="reveal mt-5 text-xl font-light leading-relaxed text-parchment/85">
        “{site.positioning}”
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl divide-y divide-white/5 px-4 md:px-6">
    {
      sections.map((s) => (
        <section class="reveal py-12">
          <p class="text-xs uppercase tracking-[0.25em] text-indigo-soft">{s.kicker}</p>
          <h2 class="mt-3 text-2xl font-bold text-gold md:text-3xl">{s.title}</h2>
          {s.bodySi && (
            <p class="mt-4 font-sinhala text-lg leading-relaxed text-parchment/80" lang="si">
              {s.bodySi}
            </p>
          )}
          <p class="mt-4 text-base leading-relaxed text-parchment/75">{s.body}</p>
        </section>
      ))
    }
  </div>

  <section class="border-t border-white/5 bg-ink-soft">
    <div class="mx-auto max-w-2xl px-4 py-16 text-center md:px-6">
      <h2 class="reveal text-2xl font-bold text-parchment">Start a conversation</h2>
      <p class="reveal mt-2 text-sm text-muted">
        Questions about our books? Reach us on WhatsApp.
      </p>
      <div class="reveal mt-7 flex justify-center">
        <WhatsAppButton href={genericContactLink()} label="WhatsApp ඔස්සේ විමසන්න" />
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { books } from '../data/books.js';
---

<BaseLayout
  title="Books"
  description="Browse the full Neja Publications catalogue — cinematic Sinhala novels available for islandwide cash-on-delivery, ordered straight through WhatsApp."
>
  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
    <header class="reveal mb-10 text-center">
      <h1 class="text-4xl font-bold text-parchment md:text-5xl">Our Books</h1>
      <p class="mt-3 font-sinhala text-lg text-muted" lang="si">අපගේ පොත්</p>
    </header>

    <div class="grid grid-cols-2 gap-5 sm:gap-6 lg:grid-cols-3">
      {books.map((book) => <BookCard book={book} />)}
    </div>
  </section>
</BaseLayout>

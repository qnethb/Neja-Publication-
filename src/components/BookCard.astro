---
import { isConfirmed } from '../data/books.js';
const { book } = Astro.props;
const href = `/books/${book.slug}`;
const showPrice = isConfirmed(book.price);
---

<article
  class="reveal group relative overflow-hidden rounded-2xl border border-white/8 bg-ink-soft transition-all duration-300 hover:border-gold/40 hover:shadow-2xl hover:shadow-burgundy/20"
>
  <a href={href} class="block">
    <!-- Cover (placeholder gradient sits behind the image so missing art never 404s visibly) -->
    <div
      class="relative aspect-[2/3] w-full overflow-hidden bg-gradient-to-br from-burgundy-deep via-ink to-indigo"
    >
      <img
        src={book.cover}
        alt={book.coverAlt}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        onerror="this.style.display='none'"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-transparent"
      >
      </div>
      <div class="absolute inset-x-0 bottom-0 p-4">
        <h3 class="font-sinhala text-xl font-bold leading-tight text-gold" lang="si">
          {book.titleSi}
        </h3>
        <p class="mt-0.5 text-sm text-parchment/85">{book.title}</p>
      </div>
    </div>
  </a>

  <div class="space-y-3 p-4">
    <p class="text-xs uppercase tracking-wider text-indigo-soft">
      {book.genre.join(' · ')}
    </p>
    <div class="flex items-center justify-between gap-3">
      <span class="text-sm font-semibold text-parchment">
        {showPrice ? book.price : <span class="text-muted">{book.price}</span>}
      </span>
      <a
        href={href}
        class="text-sm font-medium text-gold transition-colors hover:text-gold-soft"
      >
        View &rarr;
      </a>
    </div>
  </div>
</article>
